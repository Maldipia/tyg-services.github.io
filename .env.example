# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key          # SERVER-SIDE ONLY — NEVER expose to client

# ─── Upstash Redis (Rate Limiting) ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─── PayMongo (Subscription Billing) ─────────────────────────────────────────
PAYMONGO_SECRET_KEY=sk_live_your_key
PAYMONGO_PUBLIC_KEY=pk_live_your_key
PAYMONGO_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=noreply@tygpos.com

# ─── Semaphore (PH SMS) ──────────────────────────────────────────────────────
SEMAPHORE_API_KEY=your-semaphore-key
SEMAPHORE_SENDER_NAME=TYGPOS

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://tygpos.com
NEXTAUTH_SECRET=your-32-char-random-secret              # openssl rand -base64 32
CRON_SECRET=your-cron-secret                            # Vercel Cron auth

# ─── Slack (Health Alerts) ───────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook
